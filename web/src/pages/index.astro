---
import Layout from "../layouts/Layout.astro";
import Demo from "../components/Demo.tsx";
import HashDemo from "../components/HashDemo.tsx";
import Download from "../components/Download.tsx";
import { resolveDownloads } from "../lib/releases";

const REPO = "https://github.com/alleato-llc/dorado";

// Resolve the Rust CLI track's newest release -> per-platform binary URLs, at
// build time. Passed into the <Download> island, which picks the right button
// per OS/arch. See src/lib/releases.ts.
const downloads = await resolveDownloads();

const tools = [
  {
    name: "dorado",
    badge: "encrypt / decrypt",
    langs: "Rust · Go · TypeScript · browser",
    body: "The cipher tool: encrypt and decrypt files or stdin, as bare raw-key CTR or a password-derived authenticated container. The command-line interface is ported to three languages plus the in-browser demo, all reading the same files.",
  },
  {
    name: "gyotaku",
    badge: "hashing",
    langs: "Rust · Go · TypeScript · browser",
    body: "A standalone Skein-512 hashing tool, like sha256sum but Skein. Kept separate from the cipher tools so a hash needs no key stack. Named for the Japanese art of fish-printing: a fingerprint of a file.",
  },
  {
    name: "dorado-gui · gyotaku-gui",
    badge: "desktop apps",
    langs: "Rust",
    body: "Both tools in a native window, built with iced and sharing one look: a password encrypt/decrypt app and a Skein-512 hashing app. Key derivation and hashing run off the UI thread. The desktop frontends are Rust-only.",
  },
];

// Implementations as rows (so the table reads top-to-bottom and adding a language
// is one more row, not a wider table). The columns are the differences only; the
// primitives, wire format, and cross-compatibility are identical everywhere (stated
// in the lead text). Kept in sync with docs/implementations.md.
const cmpCols = ["Role / frontends", "Cipher engine", "Key derivation", "Streaming", "Secret memory"];
const cmpRows = [
  { name: "Rust", ref: true, cells: ["Reference; CLIs + 2 GUIs", "native", "argon2 / scrypt / pbkdf2 crates", "Yes", "zeroize wipe + mlock'd password"] },
  { name: "Go", cells: ["Port; CLIs", "native", "x/crypto + stdlib", "Yes", "wipes keys; mlocks password (off-heap)"] },
  { name: "C", cells: ["Port; CLIs", "native", "libargon2 + OpenSSL", "Yes", "wipes keys; mlocks password"] },
  { name: "C++", cells: ["Port; CLIs", "native", "OpenSSL EVP_KDF", "Yes", "wipes keys; mlocks password"] },
  { name: "Zig", cells: ["Port; CLIs", "native", "Zig stdlib (no deps)", "Yes", "wipes keys; mlocks password"] },
  { name: "Java", cells: ["Port; SDK only", "native", "Bouncy Castle", "Yes", "caller-managed"] },
  { name: "Python", cells: ["Port; CLIs", "native", "argon2-cffi + hashlib", "Yes", "caller-managed"] },
  { name: "Haskell", cells: ["Port; CLIs", "native", "crypton", "Yes", "caller-managed"] },
  { name: "TypeScript · Node", cells: ["Port; CLIs", "WASM (Rust core)", "hash-wasm", "No (in-memory)", "locked off-heap buffers"] },
  { name: "TypeScript · Browser", cells: ["In-page demo", "WASM (Rust core)", "hash-wasm", "No (in-memory)", "none (demo)"] },
];

const primitives = [
  {
    name: "Threefish",
    badge: "256 · 512 · 1024",
    body: "The tweakable ARX block cipher at the core of Skein, all three sizes, encrypt and decrypt, following the Skein 1.3 spec. No S-boxes, no lookup tables.",
  },
  {
    name: "CTR mode",
    body: "Turns the block cipher into any-length encryption. The same routine encrypts and decrypts; the counter is public.",
  },
  {
    name: "Key derivation",
    body: "Argon2id, scrypt, or PBKDF2-HMAC-SHA256, with cost parameters stored in the header and bounded on decrypt to refuse a hostile file.",
  },
  {
    name: "MAC menu",
    badge: "3 from scratch",
    body: "Authentication via Skein-512 (default), HMAC-SHA256, or keyed BLAKE3. All produce 32-byte tags and are bound into the header.",
  },
];
---

<Layout
  title="dorado — Threefish, from scratch"
  description="An educational, from-scratch implementation of Threefish (the cipher behind Skein), with a small honest tool stack: CTR, an authenticated password container, and a Skein hash tool, implemented ten ways in Rust, Go, C, C++, Zig, Java, Python, Haskell, and TypeScript."
>
  <section class="hero">
    <div class="wrap">
      <span class="eyebrow">Educational · Unaudited · Built from scratch</span>
      <h1>dorado</h1>
      <p class="tagline">Threefish, built from scratch.</p>
      <p class="lead">
        The tweakable block cipher at the heart of the Skein hash function, all
        three sizes, with a small and honest tool stack on top: counter mode, an
        authenticated streaming password container, and a Skein hashing tool. One
        cipher and one file format, implemented from scratch ten ways: Rust, Go,
        C, C++, Zig, Java, Python, Haskell, and TypeScript (which also runs in your browser).
      </p>
      <div class="cta">
        <Download client:load {...downloads} />
        <a class="btn ghost" href={REPO}>View the source</a>
      </div>
      <p class="demo-note">
        <a href={`${REPO}/blob/main/rust/docs/overview.md`}>Read the docs</a>
      </p>

      <!-- Real app screenshots (dorado-gui / gyotaku-gui, generated by
           scripts/generate_screenshots.py) in a theme-matched carousel with
           TWO app sets. The segmented toggle picks the app; CSS shows only
           the current app+theme's shot; every shot for that pair cycles.
           Single click pauses/plays; double click maximizes (Esc /
           click-away / double-click to exit). Dots rebuild per set. Honors
           reduced-motion. -->
      <div class="hero-shot" data-carousel data-app="dorado">
        <div class="app-toggle" role="tablist" aria-label="Which app to preview">
          <button class="at-opt is-active" data-app="dorado" role="tab">dorado</button>
          <button class="at-opt" data-app="gyotaku" role="tab">gyotaku</button>
        </div>
        <div class="shots">
          <!-- dorado (encrypt/decrypt GUI) -->
          <img class="shot shot-dark is-active" data-app="dorado" data-slide="0"
            src="/screenshots/dorado-encrypt-dracula.png"
            alt="dorado's encrypt view in the Dracula theme: a password and the message 'The quick brown fox jumps over the lazy dog.' entered, with the resulting ciphertext hex shown under Output"
            width="960" height="1560" loading="eager" />
          <img class="shot shot-light is-active" data-app="dorado" data-slide="0"
            src="/screenshots/dorado-encrypt-solarized-light.png"
            alt="dorado's encrypt view in the Solarized Light theme: a password and the message 'The quick brown fox jumps over the lazy dog.' entered, with the resulting ciphertext hex shown under Output"
            width="960" height="1560" loading="eager" />
          <!-- gyotaku (hashing GUI) -->
          <img class="shot shot-dark" data-app="gyotaku" data-slide="0"
            src="/screenshots/gyotaku-hash-dracula.png"
            alt="gyotaku's hash view in the Dracula theme: a message entered with the 256-bit Skein-512 output length selected, ready to compute the digest"
            width="920" height="1520" loading="lazy" />
          <img class="shot shot-light" data-app="gyotaku" data-slide="0"
            src="/screenshots/gyotaku-hash-solarized-light.png"
            alt="gyotaku's hash view in the Solarized Light theme: a message entered with the 256-bit Skein-512 output length selected, ready to compute the digest"
            width="920" height="1520" loading="lazy" />
        </div>
        <div class="dots" aria-label="Screenshot navigation"></div>
      </div>
      <div class="lightbox" aria-hidden="true">
        <img class="lightbox-img" alt="" />
      </div>

      <script>
        // Theme-aware screenshot carousel. It cycles every shot for the
        // current app + theme (CSS hides the other app/theme), rebuilding
        // its dots when the theme toggles. Single click = pause/play; double
        // click = maximize; Esc / click-away / double-click exits.
        // Reduced-motion users start paused.
        const root = document.querySelector<HTMLElement>(".hero-shot[data-carousel]");
        const lightbox = document.querySelector<HTMLElement>(".lightbox");
        if (root && lightbox) {
          const shots = root.querySelector<HTMLElement>(".shots")!;
          const dotsWrap = root.querySelector<HTMLElement>(".dots")!;
          const lightImg = lightbox.querySelector<HTMLImageElement>(".lightbox-img")!;
          let index = 0;
          let timer: number | undefined;
          let clickTimer: number | undefined;
          let wasPaused = false;
          let paused = matchMedia("(prefers-reduced-motion: reduce)").matches;

          const theme = () =>
            document.documentElement.dataset.theme === "light" ? "light" : "dark";
          const app = () =>
            root.dataset.app === "gyotaku" ? "gyotaku" : "dorado";
          const slides = () =>
            [
              ...root.querySelectorAll<HTMLImageElement>(
                `.shot-${theme()}[data-app="${app()}"]`,
              ),
            ].sort((a, b) => Number(a.dataset.slide) - Number(b.dataset.slide));

          // Real screenshots, not a fixed design asset: each app -- even each
          // scene within an app -- can be a different real window size (a
          // shorter view has less content, so its shot is shorter). The box
          // tracks the ACTIVE slide's own width/height (the explicit img
          // attributes, always present pre-decode, not naturalWidth/Height)
          // so object-fit: contain never has to letterbox or crop real UI.
          const setRatio = (img: HTMLImageElement) => {
            shots.style.setProperty("--shot-ratio", `${img.width} / ${img.height}`);
          };

          const render = () => {
            const list = slides();
            index = ((index % list.length) + list.length) % list.length;
            root.querySelectorAll(".shot").forEach((s) => s.classList.remove("is-active"));
            const active = list[index];
            active?.classList.add("is-active");
            if (active) setRatio(active);
            [...dotsWrap.children].forEach((d, k) =>
              d.classList.toggle("is-active", k === index),
            );
          };
          const buildDots = () => {
            dotsWrap.innerHTML = "";
            slides().forEach((_, k) => {
              const b = document.createElement("button");
              b.className = "dot" + (k === index ? " is-active" : "");
              b.setAttribute("aria-label", `Show screenshot ${k + 1}`);
              b.addEventListener("click", (e) => {
                e.stopPropagation();
                pause();
                index = k;
                render();
              });
              dotsWrap.appendChild(b);
            });
          };
          const stop = () => {
            if (timer) clearInterval(timer);
            timer = undefined;
          };
          const play = () => {
            stop();
            if (!paused)
              timer = window.setInterval(() => {
                index += 1;
                render();
              }, 5500);
          };
          const pause = () => {
            paused = true;
            root.classList.add("is-paused");
            stop();
          };
          const togglePlay = () => {
            paused = !paused;
            root.classList.toggle("is-paused", paused);
            paused ? stop() : play();
          };

          const maximize = () => {
            const list = slides();
            lightImg.src = list[index].src;
            lightImg.alt = list[index].alt;
            lightbox.classList.add("open");
            lightbox.setAttribute("aria-hidden", "false");
            wasPaused = paused;
            pause();
          };
          const exitMax = () => {
            if (!lightbox.classList.contains("open")) return;
            lightbox.classList.remove("open");
            lightbox.setAttribute("aria-hidden", "true");
            paused = wasPaused;
            root.classList.toggle("is-paused", paused);
            play();
          };

          // Single click pauses/plays; a double click cancels the pending
          // single action and maximizes instead.
          shots.addEventListener("click", () => {
            clearTimeout(clickTimer);
            clickTimer = window.setTimeout(togglePlay, 250);
          });
          shots.addEventListener("dblclick", () => {
            clearTimeout(clickTimer);
            maximize();
          });

          lightbox.addEventListener("click", (e) => {
            if (e.target === lightbox) exitMax(); // click away (backdrop)
          });
          lightbox.addEventListener("dblclick", exitMax);
          document.addEventListener("keydown", (e) => {
            if (e.key === "Escape") exitMax();
          });

          new MutationObserver(() => {
            buildDots();
            render();
          }).observe(document.documentElement, {
            attributes: true,
            attributeFilter: ["data-theme"],
          });

          // Segmented app toggle: switch the dorado/gyotaku set, reset to
          // its first slide, and rebuild dots + track.
          root.querySelectorAll<HTMLButtonElement>(".at-opt").forEach((btn) => {
            btn.addEventListener("click", (e) => {
              e.stopPropagation();
              const chosen = btn.dataset.app ?? "dorado";
              if (root.dataset.app === chosen) return;
              root.dataset.app = chosen;
              root.querySelectorAll(".at-opt").forEach((b) =>
                b.classList.toggle(
                  "is-active",
                  (b as HTMLElement).dataset.app === chosen,
                ),
              );
              index = 0;
              buildDots();
              render();
            });
          });

          buildDots();
          render();
          play();
        }
      </script>
    </div>
  </section>

  <section id="tools">
    <div class="wrap">
      <h2>Three tools, one cipher</h2>
      <p class="sub">
        The project is the cipher plus a few tools that read one shared file
        format. The command-line tool and the hasher are ported across languages;
        the desktop app is the one Rust-only frontend.
      </p>
      <div class="grid">
        {
          tools.map((t) => (
            <div class="card">
              <h3>
                {t.name}
                <span class="badge">{t.badge}</span>
              </h3>
              <p>{t.body}</p>
              <p class="card-langs">{t.langs}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section id="demo">
    <div class="wrap">
      <h2>Try it in your browser</h2>
      <p class="sub">
        Both tools, entirely client-side, over the verified Rust core compiled to
        WebAssembly. Nothing leaves your browser.
      </p>

      <h3 class="demo-heading">Encrypt and decrypt</h3>
      <p class="sub">
        Encrypt a message to a password container and decrypt it back. The
        container is the same one the CLIs read, so this output decrypts with
        <code>dorado decrypt</code> and vice versa.
      </p>
      <Demo client:only="preact" />

      <h3 class="demo-heading">Hash</h3>
      <p class="sub">
        Skein-512 hash a message at a chosen output length, the
        <code>gyotaku</code> tool in the browser. The digest matches
        <code>gyotaku</code> for the same input.
      </p>
      <HashDemo client:only="preact" />
    </div>
  </section>

  <section id="layers">
    <div class="wrap">
      <h2>How it works</h2>
      <p class="sub">
        Each layer is a thin step above the one below. The cipher is the
        foundation; everything else is standard machinery wrapped around it.
      </p>
      <div class="layers">
        <div class="layer">
          <div>
            <b>Threefish is the algorithm.</b>
            <span>
              {" "}A keyed, reversible scramble of one fixed-size block, with a
              non-secret tweak. Verified against official test vectors.
            </span>
          </div>
        </div>
        <div class="layer">
          <div>
            <b>CTR is a mode.</b>
            <span>
              {" "}A generic recipe that wraps the cipher to handle any length. It
              only calls the cipher and holds no cipher internals.
            </span>
          </div>
        </div>
        <div class="layer">
          <div>
            <b>The tools add the rest.</b>
            <span>
              {" "}Key derivation from a password, encrypt-then-MAC
              authentication, and a chunked streaming file format, so tampering, a
              wrong password, reordering, and truncation are all detected.
            </span>
          </div>
        </div>
      </div>

      <div class="grid" style="margin-top: 1rem;">
        {
          primitives.map((p) => (
            <div class="card">
              <h3>
                {p.name}
                {p.badge && <span class="badge">{p.badge}</span>}
              </h3>
              <p>{p.body}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section id="verified">
    <div class="wrap">
      <h2>How we know it works</h2>
      <p class="sub">
        Confidence comes from several independent checks. None of this is a
        security claim; it is evidence that the code matches the specifications it
        targets.
      </p>
      <ul class="checks">
        <li>
          <b>Known-answer tests</b> against official Threefish vectors for each
          block size.
        </li>
        <li>
          <b>Differential testing</b> against the RustCrypto crates: Threefish,
          and the from-scratch Skein-512 and BLAKE3, over many random inputs.
        </li>
        <li>
          <b>Construction tests</b> for round-trips, wrong passwords, tampering,
          truncation, and every MAC.
        </li>
        <li>
          <b>Fuzzing and <code>#![forbid(unsafe_code)]</code></b> across every
          crate, with a fuzz target over the decrypt parser.
        </li>
      </ul>
    </div>
  </section>

  <section id="implementations">
    <div class="wrap">
      <h2>One cipher, ten implementations</h2>
      <p class="sub">
        Dorado is written ten ways: Rust (the reference), Go, C, C++, Zig, Java (a
        library only), Python, Haskell, and a TypeScript port that runs both in Node
        and in your browser. All reimplement the same primitives from scratch, share the
        same on-disk format, and are byte-for-byte cross-compatible, so a file made
        by one opens in the others. What differs is what each runtime allows; the
        two TypeScript rows are the same code, only the runtime changes.
      </p>
      <div class="cmp-scroll">
        <table class="cmp">
          <thead>
            <tr>
              <th scope="col">Implementation</th>
              {cmpCols.map((c) => <th scope="col">{c}</th>)}
            </tr>
          </thead>
          <tbody>
            {
              cmpRows.map((row) => (
                <tr class={row.ref ? "cmp-ref" : undefined}>
                  <th scope="row">{row.name}</th>
                  {row.cells.map((c) => (
                    <td>{c}</td>
                  ))}
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
      <p class="demo-note" style="margin-top: 1rem;">
        Axes left out above: the cipher primitives build bare-metal (no OS, no
        allocator) in Rust, C, and Zig; only Rust documents a full constant-time
        discipline; and memory safety is why Rust leads overall, since it alone
        prevents the use-after-free and overrun bugs that can leak a secret at
        compile time (the wipe-and-lock mechanism itself is matched by C, Zig, and
        Go). Full breakdown in{" "}
        <a href={`${REPO}/blob/main/docs/implementations.md`}><code>docs/implementations.md</code></a>.
      </p>
    </div>
  </section>

  <section id="source">
    <div class="wrap">
      <h2>Build and run</h2>
      <p class="sub">
        The reference build is the Rust workspace in <code>rust/</code>, streaming
        in constant memory. The Go and TypeScript ports build the same
        <code>dorado</code> and <code>gyotaku</code> commands over the same files
        (see the comparison above).
      </p>
      <pre class="snippet mono"><code>cd rust
cargo build --release --workspace

# password-encrypt a file (authenticated)
target/release/dorado encrypt --password --in notes.txt --out notes.txt.mahi

# Skein-hash a file
target/release/gyotaku notes.txt</code></pre>

      <div class="note" style="margin-top: 1.5rem;">
        <b>Honest by design.</b> dorado is educational and unaudited. It is not
        described as secure, production-ready, or guaranteed constant-time. The
        cipher provides confidentiality only; the password container adds
        authentication. For real data, prefer an audited tool.
      </div>

      <div class="cta" style="justify-content: flex-start; margin-top: 1.5rem;">
        <a class="btn primary" href={REPO}>Browse the code</a>
        <a class="btn ghost" href={`${REPO}/blob/main/docs/spec.md`}>
          Read the wire format
        </a>
      </div>
    </div>
  </section>
</Layout>
