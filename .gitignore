# Rust build output (the main workspace and the separate fuzz/wasm/gui crates).
/rust/target
/rust/fuzz/target
/rust/wasm/target
# dorado-gui, dorado-gui-kit, and dorado-gyotaku-gui depend on the sibling `rime`
# component kit by path, so they are excluded from the main workspace (a path
# dependency would otherwise force every job touching the main workspace, e.g.
# the CLI-only release pipeline, to also check out `rime`) and each resolves its
# own separate Cargo.lock/target dir instead of sharing the main workspace's.
/rust/crates/dorado-gui/target
/rust/crates/dorado-gui-kit/target
/rust/crates/dorado-gyotaku-gui/target
# wasm-pack build output (regenerated by `wasm-pack build`).
/rust/wasm/pkg

# Fuzzing corpora and crash artifacts.
/rust/fuzz/corpus
/rust/fuzz/artifacts

# Cargo.lock is committed everywhere in rust/ (the main workspace and each
# separately-excluded GUI crate): this ships binaries (the CLIs and GUIs), so a
# pinned, reproducible dependency set is wanted throughout.

# Web landing page (web/).
/web/node_modules
/web/dist
/web/.astro

# TypeScript port (ts/).
/ts/node_modules
/ts/coverage
/ts/dist

# Java port (java/). The Gradle wrapper (gradlew, gradle/wrapper/) is committed.
/java/.gradle
/java/build
/java/bin

# Python port (python/).
/python/.venv
/python/dist
/python/build
/python/.pytest_cache
/python/**/__pycache__
/python/**/*.egg-info

# C port (c/) build artifacts.
/c/src/*.o
/c/libdorado.a
/c/dorado
/c/gyotaku
/c/tests/test_dorado
/c/tests/test_dorado_san
/c/tests/*.dSYM
/c/fuzz/fuzz_decrypt

# Zig port (zig/) build artifacts.
/zig/.zig-cache
/zig/zig-out

# Benchmark build artifacts (bench/). results.json + RESULTS.md are committed.
/bench/rust/target
/bench/c/dorado-bench
/bench/zig/.zig-cache
/bench/zig/zig-out
/bench/__pycache__/
/bench/cpp/dorado-bench
/bench/go/dorado-bench
/bench/haskell/dorado-bench
/bench/haskell/*.hi
/bench/haskell/*.o
/bench/java/*.class
