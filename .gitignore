# Rust build output (the main workspace and the separate fuzz/wasm crates).
/rust/target
/rust/fuzz/target
/rust/wasm/target
# wasm-pack build output (regenerated by `wasm-pack build`).
/rust/wasm/pkg

# Fuzzing corpora and crash artifacts.
/rust/fuzz/corpus
/rust/fuzz/artifacts

# Cargo.lock is committed: this workspace ships binaries (the CLIs and GUI), so a
# pinned, reproducible dependency set is wanted.

# Web landing page (web/).
/web/node_modules
/web/dist
/web/.astro

# TypeScript port (ts/).
/ts/node_modules
/ts/coverage
/ts/dist

# Java port (java/). The Gradle wrapper (gradlew, gradle/wrapper/) is committed.
/java/.gradle
/java/build

# Python port (python/).
/python/.venv
/python/dist
/python/build
/python/.pytest_cache
/python/**/__pycache__
/python/**/*.egg-info

# C port (c/) build artifacts.
/c/src/*.o
/c/libdorado.a
/c/dorado
/c/gyotaku
/c/tests/test_dorado

# Zig port (zig/) build artifacts.
/zig/.zig-cache
/zig/zig-out

# Benchmark build artifacts (bench/). results.json + RESULTS.md are committed.
/bench/rust/target
/bench/c/dorado-bench
/bench/zig/.zig-cache
/bench/zig/zig-out
/bench/go/dorado-bench
/bench/java/*.class
