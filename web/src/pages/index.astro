---
import Layout from "../layouts/Layout.astro";
import Demo from "../components/Demo.tsx";
import HashDemo from "../components/HashDemo.tsx";

// Update this to the real repository URL once it is published.
const REPO = "https://github.com/nycjv321/dorado";

const tools = [
  {
    name: "dorado",
    badge: "encrypt / decrypt",
    langs: "Rust · Go · TypeScript · browser",
    body: "The cipher tool: encrypt and decrypt files or stdin, as bare raw-key CTR or a password-derived authenticated container. The command-line interface is ported to three languages plus the in-browser demo, all reading the same files.",
  },
  {
    name: "gyotaku",
    badge: "hashing",
    langs: "Rust · Go · TypeScript · browser",
    body: "A standalone Skein-512 hashing tool, like sha256sum but Skein. Kept separate from the cipher tools so a hash needs no key stack. Named for the Japanese art of fish-printing: a fingerprint of a file.",
  },
  {
    name: "dorado-gui · gyotaku-gui",
    badge: "desktop apps",
    langs: "Rust",
    body: "Both tools in a native window, built with iced and sharing one look: a password encrypt/decrypt app and a Skein-512 hashing app. Key derivation and hashing run off the UI thread. The desktop frontends are Rust-only.",
  },
];

// Implementations as rows (so the table reads top-to-bottom and adding a language
// is one more row, not a wider table). The columns are the differences only; the
// primitives, wire format, and cross-compatibility are identical everywhere (stated
// in the lead text). Kept in sync with docs/implementations.md.
const cmpCols = ["Role / frontends", "Cipher engine", "Key derivation", "Streaming", "Secret memory"];
const cmpRows = [
  { name: "Rust", ref: true, cells: ["Reference; CLIs + 2 GUIs", "native", "argon2 / scrypt / pbkdf2 crates", "Yes", "wiped on drop (zeroize)"] },
  { name: "Go", cells: ["Port; CLIs", "native", "x/crypto + stdlib", "Yes", "wipes keys; mlocks password (off-heap)"] },
  { name: "Java", cells: ["Port; SDK only", "native", "Bouncy Castle", "Yes", "caller-managed"] },
  { name: "Python", cells: ["Port; CLIs", "native", "argon2-cffi + hashlib", "Yes", "caller-managed"] },
  { name: "C", cells: ["Port; CLIs", "native", "libargon2 + OpenSSL", "Yes", "wipes keys; mlocks password"] },
  { name: "Zig", cells: ["Port; CLIs", "native", "Zig stdlib (no deps)", "Yes", "wipes keys; mlocks password"] },
  { name: "TypeScript · Node", cells: ["Port; CLIs", "WASM (Rust core)", "hash-wasm", "No (in-memory)", "locked off-heap buffers"] },
  { name: "TypeScript · Browser", cells: ["In-page demo", "WASM (Rust core)", "hash-wasm", "No (in-memory)", "none (demo)"] },
];

const primitives = [
  {
    name: "Threefish",
    badge: "256 · 512 · 1024",
    body: "The tweakable ARX block cipher at the core of Skein, all three sizes, encrypt and decrypt, following the Skein 1.3 spec. No S-boxes, no lookup tables.",
  },
  {
    name: "CTR mode",
    body: "Turns the block cipher into any-length encryption. The same routine encrypts and decrypts; the counter is public.",
  },
  {
    name: "Key derivation",
    body: "Argon2id, scrypt, or PBKDF2-HMAC-SHA256, with cost parameters stored in the header and bounded on decrypt to refuse a hostile file.",
  },
  {
    name: "MAC menu",
    badge: "3 from scratch",
    body: "Authentication via Skein-512 (default), HMAC-SHA256, or keyed BLAKE3. All produce 32-byte tags and are bound into the header.",
  },
];
---

<Layout
  title="dorado — Threefish, from scratch"
  description="An educational, from-scratch implementation of Threefish (the cipher behind Skein), with a small honest tool stack: CTR, an authenticated password container, and a Skein hash tool, in Rust, Go, and TypeScript."
>
  <section class="hero">
    <div class="wrap">
      <span class="eyebrow">Educational · Unaudited · Built from scratch</span>
      <h1>dorado</h1>
      <p class="tagline">Threefish, built from scratch.</p>
      <p class="lead">
        The tweakable block cipher at the heart of the Skein hash function, all
        three sizes, with a small and honest tool stack on top: counter mode, an
        authenticated streaming password container, and a Skein hashing tool. One
        cipher and one file format, implemented in Rust, Go, and TypeScript.
      </p>
      <div class="cta">
        <a class="btn primary" href={REPO}>View the source</a>
        <a class="btn ghost" href={`${REPO}/blob/main/rust/docs/overview.md`}>
          Read the docs
        </a>
      </div>
    </div>
  </section>

  <section id="tools">
    <div class="wrap">
      <h2>Three tools, one cipher</h2>
      <p class="sub">
        The project is the cipher plus a few tools that read one shared file
        format. The command-line tool and the hasher are ported across languages;
        the desktop app is the one Rust-only frontend.
      </p>
      <div class="grid">
        {
          tools.map((t) => (
            <div class="card">
              <h3>
                {t.name}
                <span class="badge">{t.badge}</span>
              </h3>
              <p>{t.body}</p>
              <p class="card-langs">{t.langs}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section id="demo">
    <div class="wrap">
      <h2>Try it in your browser</h2>
      <p class="sub">
        Both tools, entirely client-side, over the verified Rust core compiled to
        WebAssembly. Nothing leaves your browser.
      </p>

      <h3 class="demo-heading">Encrypt and decrypt</h3>
      <p class="sub">
        Encrypt a message to a password container and decrypt it back. The
        container is the same one the CLIs read, so this output decrypts with
        <code>dorado decrypt</code> and vice versa.
      </p>
      <Demo client:only="preact" />

      <h3 class="demo-heading">Hash</h3>
      <p class="sub">
        Skein-512 hash a message at a chosen output length, the
        <code>gyotaku</code> tool in the browser. The digest matches
        <code>gyotaku</code> for the same input.
      </p>
      <HashDemo client:only="preact" />
    </div>
  </section>

  <section id="layers">
    <div class="wrap">
      <h2>How it works</h2>
      <p class="sub">
        Each layer is a thin step above the one below. The cipher is the
        foundation; everything else is standard machinery wrapped around it.
      </p>
      <div class="layers">
        <div class="layer">
          <div>
            <b>Threefish is the algorithm.</b>
            <span>
              {" "}A keyed, reversible scramble of one fixed-size block, with a
              non-secret tweak. Verified against official test vectors.
            </span>
          </div>
        </div>
        <div class="layer">
          <div>
            <b>CTR is a mode.</b>
            <span>
              {" "}A generic recipe that wraps the cipher to handle any length. It
              only calls the cipher and holds no cipher internals.
            </span>
          </div>
        </div>
        <div class="layer">
          <div>
            <b>The tools add the rest.</b>
            <span>
              {" "}Key derivation from a password, encrypt-then-MAC
              authentication, and a chunked streaming file format, so tampering, a
              wrong password, reordering, and truncation are all detected.
            </span>
          </div>
        </div>
      </div>

      <div class="grid" style="margin-top: 1rem;">
        {
          primitives.map((p) => (
            <div class="card">
              <h3>
                {p.name}
                {p.badge && <span class="badge">{p.badge}</span>}
              </h3>
              <p>{p.body}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section id="verified">
    <div class="wrap">
      <h2>How we know it works</h2>
      <p class="sub">
        Confidence comes from several independent checks. None of this is a
        security claim; it is evidence that the code matches the specifications it
        targets.
      </p>
      <ul class="checks">
        <li>
          <b>Known-answer tests</b> against official Threefish vectors for each
          block size.
        </li>
        <li>
          <b>Differential testing</b> against the RustCrypto crates: Threefish,
          and the from-scratch Skein-512 and BLAKE3, over many random inputs.
        </li>
        <li>
          <b>Construction tests</b> for round-trips, wrong passwords, tampering,
          truncation, and every MAC.
        </li>
        <li>
          <b>Fuzzing and <code>#![forbid(unsafe_code)]</code></b> across every
          crate, with a fuzz target over the decrypt parser.
        </li>
      </ul>
    </div>
  </section>

  <section id="implementations">
    <div class="wrap">
      <h2>One cipher, eight implementations</h2>
      <p class="sub">
        Dorado is written eight ways: Rust (the reference), Go, Java (a library
        only), Python, C, Zig, and a TypeScript port that runs both in Node and in
        your browser. All reimplement the same primitives from scratch, share the
        same on-disk format, and are byte-for-byte cross-compatible, so a file made
        by one opens in the others. What differs is what each runtime allows; the
        two TypeScript rows are the same code, only the runtime changes.
      </p>
      <div class="cmp-scroll">
        <table class="cmp">
          <thead>
            <tr>
              <th scope="col">Implementation</th>
              {cmpCols.map((c) => <th scope="col">{c}</th>)}
            </tr>
          </thead>
          <tbody>
            {
              cmpRows.map((row) => (
                <tr class={row.ref ? "cmp-ref" : undefined}>
                  <th scope="row">{row.name}</th>
                  {row.cells.map((c) => (
                    <td>{c}</td>
                  ))}
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
      <p class="demo-note" style="margin-top: 1rem;">
        Two more axes are left out above: the cipher primitives build bare-metal
        (no OS, no allocator) in Rust, C, and Zig, and only Rust documents a full
        constant-time discipline. Full breakdown in{" "}
        <a href={`${REPO}/blob/main/docs/implementations.md`}><code>docs/implementations.md</code></a>.
      </p>
    </div>
  </section>

  <section id="source">
    <div class="wrap">
      <h2>Build and run</h2>
      <p class="sub">
        The reference build is the Rust workspace in <code>rust/</code>, streaming
        in constant memory. The Go and TypeScript ports build the same
        <code>dorado</code> and <code>gyotaku</code> commands over the same files
        (see the comparison above).
      </p>
      <pre class="snippet mono"><code>cd rust
cargo build --release --workspace

# password-encrypt a file (authenticated)
target/release/dorado encrypt --password --in notes.txt --out notes.txt.mahi

# Skein-hash a file
target/release/gyotaku notes.txt</code></pre>

      <div class="note" style="margin-top: 1.5rem;">
        <b>Honest by design.</b> dorado is educational and unaudited. It is not
        described as secure, production-ready, or guaranteed constant-time. The
        cipher provides confidentiality only; the password container adds
        authentication. For real data, prefer an audited tool.
      </div>

      <div class="cta" style="justify-content: flex-start; margin-top: 1.5rem;">
        <a class="btn primary" href={REPO}>Browse the code</a>
        <a class="btn ghost" href={`${REPO}/blob/main/docs/spec.md`}>
          Read the wire format
        </a>
      </div>
    </div>
  </section>
</Layout>
