# Rust build output (the main workspace and the separate fuzz/wasm crates).
/rust/target
/rust/fuzz/target
/rust/wasm/target
# wasm-pack build output (regenerated by `wasm-pack build`).
/rust/wasm/pkg

# Fuzzing corpora and crash artifacts.
/rust/fuzz/corpus
/rust/fuzz/artifacts

# Cargo.lock is committed: this workspace ships binaries (the CLIs and GUI), so a
# pinned, reproducible dependency set is wanted.

# Web landing page (web/).
/web/node_modules
/web/dist
/web/.astro

# TypeScript port (ts/).
/ts/node_modules
/ts/coverage
/ts/dist

# Java port (java/). The Gradle wrapper (gradlew, gradle/wrapper/) is committed.
/java/.gradle
/java/build

# Python port (python/).
/python/.venv
/python/dist
/python/build
/python/.pytest_cache
/python/**/__pycache__
/python/**/*.egg-info

# C port (c/) build artifacts.
/c/src/*.o
/c/libdorado.a
/c/dorado
/c/gyotaku
/c/tests/test_dorado
