cabal-version:      2.4
name:               dorado
version:            0.1.0
synopsis:           From-scratch Threefish/Skein/BLAKE3 and the DRDO container (Haskell port).
description:        Haskell port of the dorado monorepo: the from-scratch Threefish
                    tweakable block cipher (256/512/1024) and CTR mode, the Skein-512
                    and BLAKE3 hashes, HMAC-SHA256, and the streaming authenticated
                    DRDO container. Byte-for-byte cross-compatible with the other ports.
                    Strict throughout (no laziness in the hot path): the primitive cores
                    run in ST over unboxed mutable arrays, and the streaming engine runs
                    in IO over handles in constant memory.
license:            MIT
build-type:         Simple

common warnings
    ghc-options: -Wall -O2

library
    import:           warnings
    hs-source-dirs:   src
    exposed-modules:  Dorado.Threefish
                      Dorado.Skein
                      Dorado.Blake3
                      Dorado.Sha256
                      Dorado.Kdf
                      Dorado.Mac
                      Dorado.Format
                      Dorado.Engine
    build-depends:    base >=4 && <5,
                      bytestring,
                      array,
                      crypton
    default-language: GHC2021

test-suite dorado-test
    import:           warnings
    type:             exitcode-stdio-1.0
    hs-source-dirs:   test
    main-is:          Spec.hs
    build-depends:    base,
                      bytestring,
                      array,
                      dorado
    default-language: GHC2021
