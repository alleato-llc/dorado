/web/node_modules
/web/dist
/web/.astro

# TypeScript port (ts/).
/ts/node_modules
/ts/coverage
/ts/dist

# Java port (java/). The Gradle wrapper (gradlew, gradle/wrapper/) is committed.
/java/.gradle
/java/build
